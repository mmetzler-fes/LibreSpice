# Ship the curated, ngspice-compatible default parts, but don't track bulk
# user-provided drop-ins (imported/added .lib/.asy/.json files).
/sub/*
/sym/*
/cmp/*
!/sub/.gitkeep
!/sym/.gitkeep
!/cmp/.gitkeep

# --- curated defaults (tracked) ---
!/sub/UniversalOpAmp2.lib
!/sub/Discretes.lib
!/sym/OpAmps/
