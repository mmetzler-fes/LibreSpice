# User/group the container runs as, so files written into ./library are owned
# by you on the host (no root/sudo needed to edit or delete them).
#
# Copy this file to .env and set your own IDs:
#     printf "UID=%s\nGID=%s\n" "$(id -u)" "$(id -g)" > .env
#
# On Docker Desktop (macOS/Windows) you can leave these at the defaults — the
# VM handles bind-mount ownership itself. On Linux, match your host account
# (find the values with:  id -u  and  id -g).
UID=1000
GID=1000
